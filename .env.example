DB_NAME=dari
DB_USER=dari
DB_PASSWORD=dari

LDAP_ORGANISATION=pnu.med
LDAP_DOMAIN=pnu.med
LDAP_BASE_DN=dc=pnu,dc=med
# Renew the LDAP server certificate this many days before it expires
LDAP_CERT_RENEW_DAYS=60

LDAP_ADMIN_PASSWORD=put_your_ldap_admin_password_here
SECRET_KEY=put_your_secret_key_here

RABBITMQ_DEFAULT_USER=dari
RABBITMQ_DEFAULT_PASS=dari
# Celery worker processes (default would be the host CPU count, not the container limit)
CELERY_CONCURRENCY=2

SITE_DOMAIN=vpn.dari.com

# Comma-separated CIDRs pushed to VPN clients as routes
VPN_PUSH_ROUTES=192.0.2.0/24,198.51.100.10/32
# Comma-separated hostnames VPN clients reach via NAT on 80/443
VPN_NAT_HOSTS=gate.example.com
# VPN client subnet; first half for UDP clients, second half for TCP fallback
VPN_SUBNET=10.8.0.0/20
# Max session length in seconds before OTP is required again; 0 = never while the client stays online
VPN_SESSION_LIFETIME=0
# Session token renewal interval in seconds; an offline client can reconnect without OTP
# for up to 2x this (604800 = up to 14 days)
VPN_SESSION_RENEWAL=604800
# Renew the VPN server certificate this many days before it expires
VPN_CERT_RENEW_DAYS=60

# SMTP defaults; can be changed later on the admin page (Email > SMTP settings)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_SUBJECT_PREFIX=[DARI]

# Security updates (auto-update.sh, installed as a systemd timer by install-auto-update.sh)
# systemd OnCalendar schedule
AUTO_UPDATE_SCHEDULE=*-*-* 04:00:00
# Rebuild local images at least this often to pick up Python package patch releases
AUTO_UPDATE_REBUILD_DAYS=7
