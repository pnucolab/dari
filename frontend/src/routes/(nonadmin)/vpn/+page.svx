<script>
    import { Alert, Button, Modal, Icon } from '#lib/components/ui/index.js';
    import { get } from '#lib/translations.js';
    import { enhance } from '$app/forms';

    let { data, form } = $props();

    const i18n = get();

    let user = $derived(data.user);

    let qr = $state(null);
    let show_qr = $state(false);

    function handleSubmit() {
        return async ({ result, update }) => {
            if (result.type === 'success') {
                qr = result.data.qr;
                show_qr = true;
            }
            await update();
        };
    }
</script>

<Modal title="QR Code" bind:open={show_qr} size="xs" autoclose>
    <p class="text-center">{i18n.t('user.vpn.modal_text')}</p>
    <img src={qr} class="w-full" alt="QR Code" />
    <div class="text-center">
        <Button color="blue">{i18n.t('user.close')}</Button>
    </div>
</Modal>

<div class="p-10">

<section id="about">

# {i18n.t(\`user.vpn_title\`)}

{i18n.t(\`user.vpn_content_1\`)} **{i18n.t(\`user.vpn_content_2\`)}**.

{i18n.t(\`user.vpn_content_3\`)}

<table class="w-full text-sm text-left text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700 mb-6">
<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
<tr>
<th class="px-6 py-3">{i18n.t('user.linux_server_name')}</th>
<th class="px-6 py-3">{i18n.t('user.linux_server_ip')}</th>
<th class="px-6 py-3">{i18n.t('user.linux_server_port')}</th>
</tr>
</thead>
<tbody>
{#each data.servers as server}
<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
<td class="px-6 py-4">{server.domainname}</td>
<td class="px-6 py-4">{server.ip}</td>
<td class="px-6 py-4">{server.port || '-'}</td>
</tr>
{:else}
<tr class="bg-white dark:bg-gray-800">
<td class="px-6 py-4 text-center" colspan="3">{i18n.t('user.linux_server_none')}</td>
</tr>
{/each}
</tbody>
</table>

{@html i18n.t('user.vpn_content_4')}

</section>

<section id="otp">

# {i18n.t(\`user.vpn_otp_title\`)}

{i18n.t(\`user.vpn_otp_content_1\`)}

## {i18n.t(\`user.vpn_otp_content_2\`)}

{i18n.t(\`user.vpn_otp_content_3\`)}

- FreeOTP
- Google Authenticator
- Microsoft Authenticator

## {i18n.t(\`user.vpn_otp_content_4\`)}

{i18n.t(\`user.vpn_otp_content_5\`)}

<form method="POST" action="?/vpn" use:enhance={handleSubmit}>
{#if !user.vpn}
<Alert color="red" class="mb-4">
    {#snippet icon()}<Icon name="info-circle-solid" class="w-5 h-5" />{/snippet}
    <span class="text-lg">
        {i18n.t('user.vpn_otp_content_6-1')}
    </span>
</Alert>
{#if form?.error}
<Alert color="red" class="mb-4" dismissable>
    {#snippet icon()}<Icon name="exclamation-circle-solid" class="w-5 h-5" />{/snippet}
    <span class="text-lg">
        {i18n.t('user.vpn.qr_error')}
    </span>
</Alert>
{/if}
<p class="text-center">
    <Button type="submit" color="blue" size="xl">{i18n.t('user.vpn_otp_content_4')}</Button>
</p>
{:else}
<Alert color="red" class="mb-4">
    {#snippet icon()}<Icon name="info-circle-solid" class="w-5 h-5" />{/snippet}
    <span class="text-lg">
        {i18n.t('user.vpn_otp_content_6-2')}
    </span>
</Alert>
<p class="text-center">
    <Button color="blue" size="xl">{i18n.t('user.vpn_otp_content_7')}</Button>
</p>
{/if}
</form>

</section>

<section id="openvpn">

# {i18n.t(\`user.vpn_openvpn_title\`)}

{i18n.t(\`user.vpn_openvpn_content_1\`)}

- [{i18n.t(\`user.vpn_openvpn_content_2\`)}](https://openvpn.net/client/)

{i18n.t(\`user.vpn_openvpn_content_3\`)}

<p class="text-center space-x-4">
    <Button href={data.profileUrl} color="blue" size="xl" download="client.ovpn">{i18n.t('user.vpn_openvpn_content_4')}</Button>
</p>

{i18n.t(\`user.vpn_openvpn_content_5\`)}

- Username: {i18n.t(\`user.vpn_openvpn_content_6\`)}
- Password: {i18n.t(\`user.vpn_openvpn_content_7\`)}

{@html i18n.t('user.vpn_openvpn_content_8')}

</section>

<section id="connect">

# {i18n.t(\`user.vpn_connect_title\`)}

{@html i18n.t('user.vpn_connect_content_1')}

</section>

</div>